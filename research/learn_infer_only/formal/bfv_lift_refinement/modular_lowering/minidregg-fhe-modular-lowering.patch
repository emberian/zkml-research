+/-- info: 'Minidregg.Compiler.FheBarrettWord.split_quotient_exact' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs in
+#print axioms Minidregg.Compiler.FheBarrettWord.split_quotient_exact
+
