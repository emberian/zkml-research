+theorem ceil_corrected_rounding {L : ℕ} (d B : ℤ) (r theta : Fin L → ℤ)
+    (hd : 0 < d) (hB : 0 < B) (hr : ∀ i, 0 ≤ r i) (hs : (∑ i, r i) ≤ B) :
+    roundDiv (∑ i, r i * theta i) d ≤
