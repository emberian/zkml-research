+        have hdist := hPz.2
+        rw [hh] at hdist
+        change Fintype.card ι-e ≤ (Finset.univ.filter fun i =>
+          (u 0 + z • u 1) i = Pz.eval (domain i)).card
+        omega
+      have hTz_agree : ∀ i, i ∈ Tz ↔ (u 0 + z • u 1) i = Pz.eval (domain i) := by
+        intro i
+        simp [Tz]
+      have hDz_eval :
