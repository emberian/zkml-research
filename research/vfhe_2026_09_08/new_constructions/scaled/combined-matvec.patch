new file mode 100644
--- /dev/null
+++ b/examples/fused_proof.rs
@@ -0,0 +1,74 @@
+//! One normal proof/verifier execution through the fused production prover path.
+//! Synthetic public workload; private key and randomness remain in process memory.
+use std::{fs, path::PathBuf, time::Instant};
+use ark_ff::PrimeField;
+use matvec::{arith::{cyclotomic_ring::CyclotomicRing, field::{Field64, Field64_2}, linalg::Matrix},
+    protocol::{prover::Prover, verifier::Verifier}, rlwe::{decrypt, encrypt}};
+
+fn main() {
+    const D: usize = 1024;
+    const P: usize = 16;
+    const WIDTH: usize = 2048;
+    const HEIGHT: usize = 4;
+    type F = Field64;
+    type E = Field64_2;
+    let out = PathBuf::from(std::env::args().nth(1).expect("public output directory"));
+    fs::create_dir(&out).expect("fresh directory required; no overwrite/retry");
+    let started = Instant::now();
+    let data: Vec<F> = (0..HEIGHT*WIDTH).map(|i| {
+        let last_column_offset = if i % WIDTH == WIDTH-1 { i/WIDTH+1 } else { 0 };
+        F::from(((i*7 + i/WIDTH*3 + 1 + last_column_offset)%P) as u64)
+    }).collect();
+    let matrix = Matrix::from_vec(data, WIDTH);
+    let values: Vec<u64> = (0..WIDTH).map(|i| ((i*5+3)%P) as u64).collect();
+    let expected: Vec<F> = matrix.mat_vec_mul(&values.iter().map(|&v|F::from(v)).collect())
+        .iter().map(|v|F::from(v.into_bigint().0[0] % P as u64)).collect();
+    assert_eq!(expected, vec![F::from(14u64), F::from(12u64), F::from(10u64), F::from(8u64)]);
+    let sk = vec![CyclotomicRing::<D,F>::get_random_bin()];
+    let x: Vec<_> = values.chunks(D).map(|msg|encrypt::<D,P,F>(&sk,msg)).collect();
+    let encryption_ns = started.elapsed().as_nanos();
+    let prepare = Instant::now();
+    let (m_rq, cache, m_mle, m_base, num_vars, mut transcript) = Prover::<D,E>::preprocess(&matrix);
+    let preprocessing_ns = prepare.elapsed().as_nanos();
+    assert_eq!(cache.evaluation_count(),0);
+    let prove_start = Instant::now();
+    let proof = Prover::<D,E>::prove(&m_rq,&cache,&m_mle,&m_base,num_vars,&mut transcript,&x,true);
+    let prove_ns = prove_start.elapsed().as_nanos();
+    assert_eq!(cache.evaluation_count(),1, "actual prover must use the fused cache once");
+    assert!(proof.r0_mle_proof.is_some() && proof.r1_mle_proof.is_some() && proof.m_mle_proof.is_some());
+    // Run the unchanged verifier with independently initialized public preprocessing.
+    let verify_start = Instant::now();
+    let (vm, vnum, mut vt) = Verifier::<D,E>::preprocess(&matrix);
+    assert!(Verifier::<D,E>::verify(&vm,vnum,&mut vt,&x,&proof).is_ok());
+    let verify_ns = verify_start.elapsed().as_nanos();
+    // Drain only after the public verifier returned success.
+    let decrypt_start = Instant::now();
+    let actual: Vec<F> = proof.y.iter().map(|ct|decrypt::<D,P,F>(&sk,ct)[0]).collect();
+    assert_eq!(actual,expected);
+    let decrypt_ns = decrypt_start.elapsed().as_nanos();
+    let mut input_bytes = vec![];
+    for ct in &x { for c in ct.get_ring_elements() { c.serialize(&mut input_bytes).unwrap(); } }
+    let mut output_bytes = vec![];
+    for ct in &proof.y { for c in ct.get_ring_elements() { c.serialize(&mut output_bytes).unwrap(); } }
+    fs::write(out.join("input_ciphertexts.bin"), &input_bytes).unwrap();
+    fs::write(out.join("output_ciphertexts.bin"), &output_bytes).unwrap();
+    fs::write(out.join("r0_commitment.bin"), &proof.r0_commitment).unwrap();
+    fs::write(out.join("r1_commitment.bin"), &proof.r1_commitment).unwrap();
+    let mut pcs_bytes = 0;
+    for (name, opening) in [("r0_opening",proof.r0_mle_proof.as_ref().unwrap()),
+                           ("r1_opening",proof.r1_mle_proof.as_ref().unwrap()),
+                           ("matrix_opening",proof.m_mle_proof.as_ref().unwrap())] {
+        fs::write(out.join(format!("{name}.bin")), &opening.proof).unwrap();
+        pcs_bytes += opening.proof.len();
+    }
+    let summary = format!(concat!("{{\n  \"status\":\"PASS\",\n  \"ring_degree\":{},\n  \"integer_width\":{},\n  \"integer_height\":{},\n",
+      "  \"ring_inner_dimension\":{},\n  \"components\":2,\n  \"fused_prover_calls\":{},\n  \"cached_field_elements\":{},\n",
+      "  \"pcs_enabled\":true,\n  \"unchanged_verifier_accepted\":true,\n  \"integer_matches\":{},\n",
+      "  \"encryption_and_fixture_ns\":{},\n  \"preprocessing_ns\":{},\n  \"prove_ns\":{},\n  \"verify_with_preprocessing_ns\":{},\n  \"decrypt_compare_ns\":{},\n",
+      "  \"input_ciphertext_bytes\":{},\n  \"output_ciphertext_bytes\":{},\n  \"pcs_opening_bytes\":{},\n  \"sumcheck_reported_bytes\":{}\n}}\n"),
+      D,WIDTH,HEIGHT,WIDTH/D,cache.evaluation_count(),cache.cached_field_elements(),actual.len(),
+      encryption_ns,preprocessing_ns,prove_ns,verify_ns,decrypt_ns,input_bytes.len(),output_bytes.len(),pcs_bytes,
+      proof.z1_sumcheck_proof.size_in_bytes()+proof.z3_sumcheck_proof.size_in_bytes());
+    fs::write(out.join("result.json"),&summary).unwrap();
+    println!("{summary}");
+}
