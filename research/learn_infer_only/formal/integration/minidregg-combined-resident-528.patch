+    fiatShamir R 0 (loggedOracle P coins.1) o ≠ none) ↔
+    (¬ R.R o.stmt.idx o.stmt.x o.stmt.y () ∧
+      fiatShamir R 0
+        (fsOracle o (srFinalChal (withOutput P (outputs j)) coins.1 coins.2)) o ≠ none)
+  rw [hv]
