+#guard_msgs in
+#print axioms Minidregg.Compiler.BfvQueryMul.Teeth.inhabited_core_fire
+
+/-- info: 'Minidregg.Compiler.BfvQueryMul.Teeth.changed_output_refused' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs in
