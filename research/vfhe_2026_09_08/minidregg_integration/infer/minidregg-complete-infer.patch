+#guard_msgs in
+#print axioms Minidregg.Compiler.BfvInferComposition.Exhibits.good_bound
+
+/-- info: 'Minidregg.Compiler.BfvInferComposition.Exhibits.rowPremiseInhabited' depends on axioms: [propext,
+ Classical.choice,
+ Quot.sound] -/
+#guard_msgs in
