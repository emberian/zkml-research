+  weightedSumGadget (leftConstant row) (digitCoefficient (leftMatrix row)) scalarWire (rowWires row false) ++
+  weightedSumGadget (rightConstant row) (digitCoefficient (rightMatrix row)) scalarWire (rowWires row true)
