+++ b/src/protocol/public_wire.rs
@@ -0,0 +1,141 @@
+//! Complete bounded public proof wire format for this fixed research configuration.
+//! This transports the real proof; it does not serialize RNG or transcript state.
+use std::io::{Cursor, Read};
+use ark_serialize::{CanonicalDeserialize, CanonicalSerialize};
+use crate::{arith::{field::{Field64 as F, Field64_2 as E}, cyclotomic_ring::CyclotomicRing,
+    linalg::Matrix}, rlwe::RLWE, protocol::{Proof, pcs::whir::WhirProof, sumcheck::SumCheckProof}};
+
+type Ct<const D:usize> = RLWE<CyclotomicRing<D,F>>;
+const MAX_ELEMENTS:usize = 1 << 20;
+const MAX_PCS_BYTES:usize = 1 << 24;
+fn put_n(out:&mut Vec<u8>, n:usize) { out.extend_from_slice(&(n as u64).to_le_bytes()); }
+fn get_n(input:&mut Cursor<&[u8]>, cap:usize)->Result<usize,String> {
+    let mut b=[0u8;8]; input.read_exact(&mut b).map_err(|e|e.to_string())?;
+    let x=u64::from_le_bytes(b); if x>cap as u64 { return Err("length cap".into()); } Ok(x as usize)
+}
+fn put_f<T:CanonicalSerialize>(out:&mut Vec<u8>,x:&T) { x.serialize_compressed(out).unwrap(); }
+fn get_f<T:CanonicalDeserialize>(input:&mut Cursor<&[u8]>)->Result<T,String> {
+    T::deserialize_compressed(input).map_err(|e|e.to_string())
+}
+fn header<const D:usize>(out:&mut Vec<u8>, kind:u8) {
+    out.extend_from_slice(b"MVFUSE01"); out.push(kind);
+    // Version, ring degree, base modulus, quadratic nonresidue, WHIR security/rate/folds,
+    // and exact ConjectureList configuration discriminator.
+    for x in [1u64,D as u64,18446744069414584321,7,100,1,4,4,1] { out.extend_from_slice(&x.to_le_bytes()); }
+}
+fn check_header<const D:usize>(input:&mut Cursor<&[u8]>,kind:u8)->Result<(),String> {
+    if D==0 || !D.is_power_of_two() || D>4096 { return Err("unsupported D".into()); }
+    let mut expected=vec![]; header::<D>(&mut expected,kind);
+    let mut actual=vec![0;expected.len()]; input.read_exact(&mut actual).map_err(|e|e.to_string())?;
+    if actual!=expected { return Err("version/field/configuration mismatch".into()); } Ok(())
+}
+fn put_cts<const D:usize>(out:&mut Vec<u8>, values:&[Ct<D>]) {
+    put_n(out,values.len());
+    for ct in values { assert_eq!(ct.rank(),1); for c in ct.get_ring_elements() {
+        assert_eq!(c.coeffs.len(),D); for v in &c.coeffs { put_f(out,v); }
+    }}
+}
+fn get_cts<const D:usize>(input:&mut Cursor<&[u8]>, expected:usize)->Result<Vec<Ct<D>>,String> {
+    if get_n(input,1024)?!=expected { return Err("ciphertext count".into()); }
+    let mut result=Vec::with_capacity(expected);
+    for _ in 0..expected { let mut components=vec![]; for _ in 0..2 {
+        let coeffs:Result<Vec<F>,_>=(0..D).map(|_|get_f(input)).collect();
+        components.push(CyclotomicRing::from_coeffs(&coeffs?));
+    } result.push(RLWE::from_ring_elements(components)); }
+    Ok(result)
+}
+fn finish(input:&Cursor<&[u8]>)->Result<(),String> {
+    if input.position()!=input.get_ref().len() as u64 { return Err("trailing bytes".into()); } Ok(())
+}
+pub fn encode_statement<const D:usize>(matrix:&Matrix<F>, x:&[Ct<D>], expected_y:&[Ct<D>])->Vec<u8> {
+    let mut out=vec![]; header::<D>(&mut out,0); put_n(&mut out,matrix.width()); put_n(&mut out,matrix.height());
+    for value in &matrix.data { put_f(&mut out,value); }
+    put_cts(&mut out,x); put_cts(&mut out,expected_y); out
+}
+pub fn decode_statement<const D:usize>(bytes:&[u8])->Result<(Matrix<F>,Vec<Ct<D>>,Vec<Ct<D>>),String> {
+    let mut input=Cursor::new(bytes); check_header::<D>(&mut input,0)?;
+    let width=get_n(&mut input,65536)?; let height=get_n(&mut input,1024)?;
+    if D==0 || !width.is_power_of_two() || !height.is_power_of_two() || width%D!=0 || width*height>MAX_ELEMENTS {
+        return Err("matrix shape".into()); }
+    let data:Result<Vec<F>,_>=(0..width*height).map(|_|get_f(&mut input)).collect();
+    let x=get_cts(&mut input,width/D)?; let y=get_cts(&mut input,height)?; finish(&input)?;
+    Ok((Matrix::from_vec(data?,width),x,y))
+}
+fn put_sum(out:&mut Vec<u8>, proof:&SumCheckProof<E>) {
+    let (claim,polys)=proof.public_parts(); put_f(out,&claim); put_n(out,polys.len());
+    for poly in polys { put_n(out,poly.len()); for c in poly {put_f(out,&c);} }
+}
+fn get_sum(input:&mut Cursor<&[u8]>, rounds:usize, degree:usize)->Result<SumCheckProof<E>,String> {
+    let claim=get_f(input)?;
+    if get_n(input,32)?!=rounds { return Err("sumcheck rounds".into()); }
+    let mut polys=vec![]; for _ in 0..rounds {
+        let count=get_n(input,degree+1)?; if count==0 {return Err("empty polynomial".into());}
+        let coeffs:Result<Vec<E>,_>=(0..count).map(|_|get_f(input)).collect(); polys.push(coeffs?);
+    } Ok(SumCheckProof::from_public_parts(claim,polys))
+}
+fn put_bytes(out:&mut Vec<u8>,data:&[u8]) {put_n(out,data.len());out.extend_from_slice(data);}
+fn get_bytes(input:&mut Cursor<&[u8]>,cap:usize)->Result<Vec<u8>,String> {
+    let size=get_n(input,cap)?;let mut out=vec![0;size];input.read_exact(&mut out).map_err(|e|e.to_string())?;Ok(out)
+}
+fn put_opening(out:&mut Vec<u8>,opening:&Option<WhirProof<E>>) {
+    let p=opening.as_ref().expect("PCS required");out.push(1);put_f(out,&p.claim);put_bytes(out,&p.proof);
+}
+fn get_opening(input:&mut Cursor<&[u8]>)->Result<Option<WhirProof<E>>,String> {
+    let mut tag=[0];input.read_exact(&mut tag).map_err(|e|e.to_string())?;
+    if tag!=[1] {return Err("all three PCS openings required".into());}
+    Ok(Some(WhirProof{claim:get_f(input)?,proof:get_bytes(input,MAX_PCS_BYTES)?}))
+}
+pub fn encode_proof<const D:usize>(proof:&Proof<D,E>)->Vec<u8> {
+    let mut out=vec![];header::<D>(&mut out,1);put_cts(&mut out,&proof.y);
+    put_sum(&mut out,&proof.z1_sumcheck_proof);put_sum(&mut out,&proof.z3_sumcheck_proof);
+    put_bytes(&mut out,&proof.r0_commitment);put_bytes(&mut out,&proof.r1_commitment);
+    put_opening(&mut out,&proof.r0_mle_proof);put_opening(&mut out,&proof.r1_mle_proof);put_opening(&mut out,&proof.m_mle_proof);out
+}
+pub fn decode_proof<const D:usize>(bytes:&[u8],width:usize,height:usize)->Result<Proof<D,E>,String> {
+    if D==0 || width>65536 || height>1024 || !width.is_power_of_two() || !height.is_power_of_two() || width%D!=0 || width*height>MAX_ELEMENTS {
+        return Err("caller shape".into()); }
+    let mut input=Cursor::new(bytes);check_header::<D>(&mut input,1)?;
+    let y=get_cts(&mut input,height)?;
+    let z1_sumcheck_proof=get_sum(&mut input,(width*height).ilog2() as usize,4)?;
+    let z3_sumcheck_proof=get_sum(&mut input,(D*height).ilog2() as usize,3)?;
+    let r0_commitment=get_bytes(&mut input,1024)?;let r1_commitment=get_bytes(&mut input,1024)?;
+    let r0_mle_proof=get_opening(&mut input)?;let r1_mle_proof=get_opening(&mut input)?;let m_mle_proof=get_opening(&mut input)?;
+    finish(&input)?;
+    Ok(Proof{y,z1_sumcheck_proof,z3_sumcheck_proof,r0_commitment,r1_commitment,r0_mle_proof,r1_mle_proof,m_mle_proof})
+}
+pub fn same_outputs<const D:usize>(a:&[Ct<D>],b:&[Ct<D>])->bool {
+    a.len()==b.len() && a.iter().zip(b).all(|(x,y)| x.rank()==y.rank() && x.get_ring_elements().iter()
+        .zip(y.get_ring_elements()).all(|(x,y)|x.coeffs==y.coeffs))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    // Public message fixture, not a cryptographic proof: every wire field is
+    // nonempty, extension coordinates are nonzero, and all coefficient order
+    // and opaque PCS bytes must survive the codec exactly.
+    #[test]
+    fn public_wire_preserves_complete_messages() {
+        const D:usize=4;
+        let matrix=Matrix::from_vec((1..=16).map(F::from).collect(),8);
+        let cts:Vec<Ct<D>>=(0..2).map(|r| RLWE::from_ring_elements((0..2).map(|k|
+            CyclotomicRing::from_coeffs(&(0..D).map(|t|F::from((1+r*31+k*13+t) as u64)).collect::<Vec<_>>())
+        ).collect())).collect();
+        let statement=encode_statement(&matrix,&cts,&cts);
+        let (m,x,y)=decode_statement::<D>(&statement).unwrap();
+        assert_eq!(matrix.data,m.data); assert!(same_outputs(&cts,&x)); assert!(same_outputs(&cts,&y));
+        assert_eq!(statement,encode_statement(&m,&x,&y));
+        let scalar=|i|E::new(F::from(i),F::from(i+17));
+        let sum=|rounds,degree|SumCheckProof::from_public_parts(scalar(11),
+            (0..rounds).map(|r| (0..=degree).map(|d|scalar(1+r*7+d)).collect()).collect());
+        let opening=|i|Some(WhirProof{claim:scalar(i),proof:vec![i as u8,3,7,0,255]});
+        let proof=Proof{y,z1_sumcheck_proof:sum(4,4),z3_sumcheck_proof:sum(3,3),
+            r0_commitment:vec![1,2,3],r1_commitment:vec![4,5,6],
+            r0_mle_proof:opening(21),r1_mle_proof:opening(22),m_mle_proof:opening(23)};
+        let bytes=encode_proof(&proof);
+        let decoded=decode_proof::<D>(&bytes,8,2).unwrap();
+        assert_eq!(bytes,encode_proof(&decoded));
+        assert_eq!(proof.z1_sumcheck_proof.public_parts(),decoded.z1_sumcheck_proof.public_parts());
+        assert_eq!(proof.z3_sumcheck_proof.public_parts(),decoded.z3_sumcheck_proof.public_parts());
+    }
+}
