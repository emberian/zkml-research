+/-- The degree-bounded kernel theorem, with all source hypotheses explicit. -/
+theorem correctness : Correctness (F := F) (ι := ι) := by
+  intro e K h
+  exact Source.RS_exists_nonzero_kernelVec_of_det_submatrix_eq_zero_natDegree_le_one
+    e K h.1 h.2.1 h.2.2
