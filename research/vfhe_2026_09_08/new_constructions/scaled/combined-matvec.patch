 impl<R: Ring> RLWE<R> {
+    /// Construct mask components followed by body, preserving the wire component order.
+    pub fn from_ring_elements(mut elements: Vec<R>) -> Self {
+        assert_eq!(elements.len(), K + 1);
+        let body = elements.pop().unwrap();
+        Self { mask: elements, body }
+    }
+
     pub fn zero() -> Self {
         RLWE {
             mask: vec![R::zero(); K],
