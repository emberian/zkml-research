+++ b/examples/matched_proof.rs
@@ -0,0 +1,91 @@
+//! One paired real proof run on one shared public matrix and encrypted input.
+//! Each path proves once. Keys and randomness remain in this process only.
+use std::{fs, path::PathBuf, process::Command, time::Instant};
+use ark_ff::PrimeField;
+use matvec::{arith::{cyclotomic_ring::CyclotomicRing, field::{Field64 as F, Field64_2 as E}, linalg::Matrix},
+    protocol::{prover::Prover, prover_unfused::Prover as Unfused, verifier::Verifier,
+      public_wire::{encode_statement, encode_proof, same_outputs}}, rlwe::{decrypt, encrypt}};
+
+fn main() {
+    const D: usize = 4096;
+    const P: usize = 16;
+    const WIDTH: usize = 8192;
+    const HEIGHT: usize = 64;
+    let out = PathBuf::from(std::env::args().nth(1).expect("public output directory"));
+    fs::create_dir(&out).expect("fresh directory required; no overwrite/retry");
+    let started = Instant::now();
+    let data: Vec<F> = (0..HEIGHT*WIDTH).map(|i| {
+        let offset = if i % WIDTH == WIDTH-1 { (i/WIDTH)%7+1 } else { 0 };
+        F::from(((i*7 + i/WIDTH*3 + 1 + offset)%P) as u64)
+    }).collect();
+    let matrix = Matrix::from_vec(data, WIDTH);
+    let values: Vec<u64> = (0..WIDTH).map(|i| ((i*5+3)%P) as u64).collect();
+    let expected: Vec<F> = matrix.mat_vec_mul(&values.iter().map(|&v|F::from(v)).collect())
+        .iter().map(|v|F::from(v.into_bigint().0[0] % P as u64)).collect();
+    assert_eq!(expected, (0..HEIGHT).map(|i|F::from((14*(i%7+1)%P) as u64)).collect::<Vec<_>>());
+    let sk = vec![CyclotomicRing::<D,F>::get_random_bin()];
+    let x: Vec<_> = values.chunks(D).map(|msg|encrypt::<D,P,F>(&sk,msg)).collect();
+    let fixture_ns = started.elapsed().as_nanos();
+
+    let timer = Instant::now();
+    let (bm, bp, b_mle, b_base, bn, mut bt) = Unfused::<D,E>::preprocess(&matrix);
+    let baseline_preprocessing_ns = timer.elapsed().as_nanos();
+    let timer = Instant::now();
+    let baseline = Unfused::<D,E>::prove(&bm,&bp,&b_mle,&b_base,bn,&mut bt,&x,true);
+    let baseline_prove_ns = timer.elapsed().as_nanos();
+    assert!(baseline.r0_mle_proof.is_some() && baseline.r1_mle_proof.is_some() && baseline.m_mle_proof.is_some());
+    let timer = Instant::now();
+    let (vm,vn,mut vt) = Verifier::<D,E>::preprocess(&matrix);
+    assert!(Verifier::<D,E>::verify(&vm,vn,&mut vt,&x,&baseline).is_ok());
+    let baseline_verify_ns = timer.elapsed().as_nanos();
+    drop((bm,bp,b_mle,b_base,bt,vm,vt));
+
+    let timer = Instant::now();
+    let (fm, cache, f_mle, f_base, fn_, mut ft) = Prover::<D,E>::preprocess(&matrix);
+    let fused_preprocessing_ns = timer.elapsed().as_nanos();
+    assert_eq!(cache.evaluation_count(),0);
+    let timer = Instant::now();
+    let fused = Prover::<D,E>::prove(&fm,&cache,&f_mle,&f_base,fn_,&mut ft,&x,true);
+    let fused_prove_ns = timer.elapsed().as_nanos();
+    assert_eq!(cache.evaluation_count(),1);
+    assert!(fused.r0_mle_proof.is_some() && fused.r1_mle_proof.is_some() && fused.m_mle_proof.is_some());
+    let timer = Instant::now();
+    let (vm,vn,mut vt) = Verifier::<D,E>::preprocess(&matrix);
+    assert!(Verifier::<D,E>::verify(&vm,vn,&mut vt,&x,&fused).is_ok());
+    let fused_verify_ns = timer.elapsed().as_nanos();
+    assert!(same_outputs(&baseline.y,&fused.y));
+
+    let statement = encode_statement::<D>(&matrix,&x,&baseline.y);
+    let baseline_bytes = encode_proof(&baseline);
+    let fused_bytes = encode_proof(&fused);
+    fs::write(out.join("statement.bin"), &statement).unwrap();
+    fs::write(out.join("baseline.proof"), &baseline_bytes).unwrap();
+    fs::write(out.join("fused.proof"), &fused_bytes).unwrap();
+    // Fresh processes reconstruct the caller-selected statement and full proof.
+    // Both saved artifacts are publicly checked before any recipient decrypt.
+    let verifier = std::env::current_exe().unwrap().with_file_name("verify_saved");
+    for name in ["baseline","fused"] {
+        let result = Command::new(&verifier).arg(out.join("statement.bin"))
+            .arg(out.join(format!("{name}.proof"))).output().unwrap();
+        fs::write(out.join(format!("{name}_replay.json")),&result.stdout).unwrap();
+        fs::write(out.join(format!("{name}_replay.stderr")),&result.stderr).unwrap();
+        assert!(result.status.success(), "fresh saved-proof verification failed");
+    }
+    let public_close_ns = started.elapsed().as_nanos();
+    let timer = Instant::now();
+    let actual: Vec<F> = fused.y.iter().map(|ct|decrypt::<D,P,F>(&sk,ct)[0]).collect();
+    assert_eq!(actual,expected);
+    let decrypt_ns = timer.elapsed().as_nanos();
+    let summary = format!(concat!("{{\n  \"status\":\"PASS\",\n  \"ring_degree\":{},\n  \"integer_width\":{},\n  \"integer_height\":{},\n",
+      "  \"ring_inner_dimension\":2,\n  \"components\":2,\n  \"same_input_objects\":true,\n  \"order\":[\"baseline\",\"fused\"],\n",
+      "  \"proofs_per_path\":1,\n  \"pcs_enabled\":true,\n  \"both_unchanged_verifiers_accepted\":true,\n  \"fresh_saved_replays_accepted\":2,\n",
+      "  \"all_output_coefficients_matched\":{},\n  \"integer_matches\":{},\n  \"fused_prover_calls\":{},\n  \"cached_field_elements\":{},\n",
+      "  \"fixture_and_encryption_ns\":{},\n  \"baseline_preprocessing_ns\":{},\n  \"baseline_prove_ns\":{},\n  \"baseline_verify_with_preprocessing_ns\":{},\n",
+      "  \"fused_preprocessing_ns\":{},\n  \"fused_prove_ns\":{},\n  \"fused_verify_with_preprocessing_ns\":{},\n",
+      "  \"public_close_before_decrypt_ns\":{},\n  \"decrypt_compare_ns\":{},\n  \"statement_bytes\":{},\n  \"baseline_proof_bytes\":{},\n  \"fused_proof_bytes\":{},\n",
+      "  \"complete_proofs_byte_equal\":{}\n}}\n"),D,WIDTH,HEIGHT,HEIGHT*2*D,actual.len(),cache.evaluation_count(),cache.cached_field_elements(),
+      fixture_ns,baseline_preprocessing_ns,baseline_prove_ns,baseline_verify_ns,fused_preprocessing_ns,fused_prove_ns,fused_verify_ns,
+      public_close_ns,decrypt_ns,statement.len(),baseline_bytes.len(),fused_bytes.len(),baseline_bytes==fused_bytes);
+    fs::write(out.join("result.json"), &summary).unwrap();
+    println!("{summary}");
+}
diff --git a/examples/verify_saved.rs b/examples/verify_saved.rs
new file mode 100644
--- /dev/null
+++ b/examples/verify_saved.rs
@@ -0,0 +1,23 @@
+//! Fresh-process public verifier: no key, encryption, prover, or transcript import.
+use std::{fs, path::Path, time::Instant};
+use matvec::{arith::field::Field64_2, protocol::{public_wire::{decode_statement,decode_proof,same_outputs},verifier::Verifier}};
+fn bounded_read(path:&Path)->Vec<u8> {
+    assert!(fs::metadata(path).unwrap().len()<=64*1024*1024,"wire file cap");
+    fs::read(path).unwrap()
+}
+fn main() {
+    const D:usize=4096;
+    let args:Vec<_>=std::env::args().collect(); assert_eq!(args.len(),3);
+    let timer=Instant::now();
+    let statement=bounded_read(Path::new(&args[1]));
+    let proof_bytes=bounded_read(Path::new(&args[2]));
+    let (matrix,x,expected_y)=decode_statement::<D>(&statement).expect("canonical caller statement");
+    let proof=decode_proof::<D>(&proof_bytes,matrix.width(),matrix.height()).expect("complete canonical proof");
+    assert!(same_outputs(&proof.y,&expected_y),"caller-selected output mismatch");
+    let decode_ns=timer.elapsed().as_nanos();
+    let timer=Instant::now();
+    let (m,n,mut transcript)=Verifier::<D,Field64_2>::preprocess(&matrix);
+    assert!(Verifier::<D,Field64_2>::verify(&m,n,&mut transcript,&x,&proof).is_ok());
+    println!("{{\"status\":\"PASS\",\"fresh_public_preprocessing\":true,\"all_three_pcs\":true,\"expected_output_matched\":true,\"decode_ns\":{},\"verify_with_preprocessing_ns\":{},\"statement_blake3\":\"{}\",\"proof_blake3\":\"{}\"}}",
+      decode_ns,timer.elapsed().as_nanos(),blake3::hash(&statement).to_hex(),blake3::hash(&proof_bytes).to_hex());
+}
diff --git a/src/arith/fused_matvec.rs b/src/arith/fused_matvec.rs
new file mode 100644
--- /dev/null
+++ b/src/arith/fused_matvec.rs
@@ -0,0 +1,108 @@
+//! One public spectral cache serves both ring evaluation and quotient witnesses.
+//! A zero-padded 2D negacyclic product equals the ordinary product (degree <2D).
+use std::{marker::PhantomData, sync::atomic::{AtomicUsize, Ordering}};
+use ark_ff::PrimeField;
+use tfhe_ntt::prime64::Plan;
+use crate::{arith::{cyclotomic_ring::CyclotomicRing, linalg::Matrix,
+    polynomial_ring::PolynomialRing}, rlwe::RLWE};
+
+pub struct FusedMatvec<const D: usize, F: PrimeField> {
+    plan: Plan,
+    spectra: Vec<Vec<u64>>,
+    width: usize,
+    height: usize,
+    evaluations: AtomicUsize,
+    _field: PhantomData<F>,
+}
+
+impl<const D: usize, F: PrimeField> FusedMatvec<D, F> {
+    pub fn new(matrix: &Matrix<CyclotomicRing<D, F>>) -> Self {
+        assert!(D.is_power_of_two());
+        assert_eq!(F::MODULUS.as_ref().len(), 1, "NTT modulus must fit u64");
+        assert!(matrix.width() > 0 && matrix.height() > 0);
+        let plan = Plan::try_new(2 * D, F::MODULUS.as_ref()[0]).expect("2D NTT plan");
+        let spectra = matrix.data.iter().map(|a| {
+            assert_eq!(a.coeffs.len(), D);
+            let mut v: Vec<u64> = a.coeffs.iter().map(|c| c.into_bigint().as_ref()[0]).collect();
+            v.resize(2 * D, 0);
+            plan.fwd(&mut v);
+            v
+        }).collect();
+        Self { plan, spectra, width: matrix.width(), height: matrix.height(),
+            evaluations: AtomicUsize::new(0), _field: PhantomData }
+    }
+
+    pub fn evaluation_count(&self) -> usize { self.evaluations.load(Ordering::Relaxed) }
+
+    pub fn cached_field_elements(&self) -> usize { self.spectra.len() * 2 * D }
+
+    pub fn evaluate(&self, x: &[RLWE<CyclotomicRing<D, F>>]) ->
+        (Vec<RLWE<CyclotomicRing<D, F>>>, Vec<Vec<PolynomialRing<D, F>>>) {
+        assert_eq!(x.len(), self.width);
+        let components = x[0].rank() + 1;
+        let xhat: Vec<Vec<Vec<u64>>> = x.iter().map(|ct| {
+            assert_eq!(ct.rank() + 1, components);
+            ct.get_ring_elements().iter().map(|c| {
+                assert_eq!(c.coeffs.len(), D);
+                let mut v: Vec<u64> = c.coeffs.iter().map(|a| a.into_bigint().as_ref()[0]).collect();
+                v.resize(2 * D, 0);
+                self.plan.fwd(&mut v);
+                v
+            }).collect()
+        }).collect();
+        let mut outputs = Vec::with_capacity(self.height);
+        let mut quotients = Vec::with_capacity(self.height);
+        for i in 0..self.height {
+            let mut row_y = Vec::with_capacity(components);
+            let mut row_q = Vec::with_capacity(components);
+            for k in 0..components {
+                let mut acc = vec![0u64; 2 * D];
+                for j in 0..self.width {
+                    self.plan.mul_accumulate(&mut acc, &self.spectra[i * self.width + j], &xhat[j][k]);
+                }
+                self.plan.normalize(&mut acc);
+                self.plan.inv(&mut acc);
+                // S=L+X^D H, hence S=(L-H)+(X^D+1)H.
+                assert_eq!(acc[2 * D - 1], 0, "Product degree must be at most 2D-2");
+                let hi: Vec<F> = acc[D..].iter().map(|&v| F::from(v)).collect();
+                let lo_minus_hi: Vec<F> = acc[..D].iter().zip(&hi).map(|(&l, h)| F::from(l) - h).collect();
+                row_y.push(CyclotomicRing::from_coeffs(&lo_minus_hi));
+                row_q.push(PolynomialRing::from_cyclotomic(&CyclotomicRing::from_coeffs(&hi)));
+            }
+            outputs.push(RLWE::from_ring_elements(row_y));
+            quotients.push(row_q);
+        }
+        self.evaluations.fetch_add(1, Ordering::Relaxed);
+        (outputs, quotients)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::arith::field::Field64;
+    #[test]
+    fn public_fused_matches_existing_products() {
+        const D: usize = 32;
+        type F = Field64;
+        let matrix = Matrix::from_vec((0..6).map(|i| {
+            CyclotomicRing::<D,F>::from_coeffs(&(0..D).map(|t| F::from((3+i*7+t*t) as u64)).collect::<Vec<_>>())
+        }).collect(), 3);
+        let x: Vec<_> = (0..3).map(|j| RLWE::from_ring_elements((0..2).map(|k| {
+            CyclotomicRing::<D,F>::from_coeffs(&(0..D).map(|t| F::from((5+j*11+k*13+t*t*t) as u64)).collect::<Vec<_>>())
+        }).collect())).collect();
+        let cache = FusedMatvec::new(&matrix);
+        let (actual_y, actual_q) = cache.evaluate(&x);
+        let old_y = matrix.mat_rlwe_vec_mul(&x);
+        let old_s = matrix.lift_to_polynomial_ring().mat_rlwe_vec_mul(&x.iter().map(|ct|ct.lift_to_polynomial_ring()).collect());
+        for i in 0..2 {
+            let (old_q, remainder) = old_s[i].long_division_by_cyclotomic();
+            for k in 0..2 {
+                assert_eq!(actual_y[i].get_ring_element(k).unwrap().coeffs, old_y[i].get_ring_element(k).unwrap().coeffs);
+                assert_eq!(actual_y[i].get_ring_element(k).unwrap().coeffs, remainder[k].coeffs);
+                assert_eq!(actual_q[i][k].coeffs, old_q[k].coeffs);
+            }
+        }
+        assert_eq!(cache.evaluation_count(), 1);
+    }
+}
