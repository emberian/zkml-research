+    signedValue (stateOf (biasedOfTwos b))=signedOfTwos b := by
+  change (((UInt8.ofNat (b.toNat+128)).toNat : Int)-128)=signedOfTwos b
+  rw [UInt8.toNat_ofNat']
+  have hb : b.toNat<256 := b.toNat_lt_size
+  unfold signedOfTwos
+  split_ifs <;> omega
