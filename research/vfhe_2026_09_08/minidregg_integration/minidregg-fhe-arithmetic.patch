+    ("exact_public_tables",toJson 2),("changed_output_refused",toJson true),("out_of_range_limb_refused",toJson true),
+    ("all_saved_native_rows_checked",toJson true),("trace_bytes",toJson (outputs.size*nVars*4))]
+  IO.FS.writeFile (outputPath/"emission.json") (report.pretty++"\n")
+  IO.println report.compress
+  return 0
