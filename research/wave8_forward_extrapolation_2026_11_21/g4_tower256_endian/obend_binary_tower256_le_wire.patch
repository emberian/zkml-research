+/-! ### Gate `G4` Little-Endian Fan–Paar Wire Conformance Teeth & Asymmetric Vectors -/
+
+def g4VecA : Tower256Exec :=
+  0x80000000000000010f0ff0f055aaaa55fedcba98765432100123456789abcdef#256
+
+def g4VecB : Tower256Exec :=
+  0x0102030405060708aaaa5555ffff00001122334455667788deadbeefcafebabe#256
+
+def g4FpGen6 : Tower256Exec := BitVec.ofNat 256 (2 ^ 64)
+def g4FpGen7 : Tower256Exec := BitVec.ofNat 256 (2 ^ 128)
+
+def g4SwapU64LimbsOnly (bs : List UInt8) : List UInt8 :=
+  (bs.drop 24).take 8 ++ (bs.drop 16).take 8 ++ (bs.drop 8).take 8 ++ bs.take 8
+
+def g4ReverseWithinU64Limbs (bs : List UInt8) : List UInt8 :=
+  (bs.take 8).reverse ++ ((bs.drop 8).take 8).reverse ++
+  ((bs.drop 16).take 8).reverse ++ ((bs.drop 24).take 8).reverse
+
+def g4SwapTowerHalvesOnly (bs : List UInt8) : List UInt8 :=
+  bs.drop 16 ++ bs.take 16
+
+def g4ReverseAllBits32 (bs : List UInt8) : List UInt8 :=
+  bs.reverse.map (fun b => UInt8.ofBitVec b.toBitVec.reverse)
+
+/-- Gate `G4` LE wire anchor: `1` sits at byte 0 (`0x01`) and `fpGen 7` (`2^128`) sits at byte 16. -/
+theorem toBytes32_basis_anchors :
+    (toBytes32 (1#256)).data.toList[0]! = 1 ∧
+    (toBytes32 (1#256)).data.toList[31]! = 0 ∧
+    (toBytes32 g4FpGen7).data.toList[16]! = 1 ∧
+    (toBytes32 g4FpGen7).data.toList[15]! = 0 := by
+  decide +kernel
+
+/-- Asymmetric non-palindromic falsifiers: BE identity, 4×`u64` limb-only swap, within-`u64` byte
+reversal, 16B `T_7` half-swap, and NIST bit-within-byte reflection all disagree with canonical LE. -/
+theorem toBytes32_asymmetric_falsifiers :
+    let beA := Obend.Digest.HashBytes.be 32 g4VecA.toNat
+    let leA := (toBytes32 g4VecA).data.toList
+    beA ≠ leA ∧
+    g4SwapU64LimbsOnly beA ≠ leA ∧
+    g4ReverseWithinU64Limbs beA ≠ leA ∧
+    g4SwapTowerHalvesOnly beA ≠ leA ∧
+    g4ReverseAllBits32 beA ≠ leA ∧
+    mulExec 8 g4VecA g4VecB =
+      0xbc34b99b865dbfd3efc1d145035df65692d8d39380691deba31bf1bf79a7c6a5#256 ∧
+    mulExec 8 g4FpGen7 g4FpGen7 = (mulExec 8 g4FpGen6 g4FpGen7 ^^^ 1#256) := by
+  decide +kernel
+
+/-- Reading big-endian `1` or `fpGen 7` directly through little-endian `ofBytes32` yields
+`2^248` and `2^120`, breaking multiplicative idempotence (`1² = 1`) and the level-8 Fan–Paar
+quadratic `y_7² + y_6 y_7 + 1 = 0`. -/
+theorem ofBytes32_missing_reversal_breaks_field_laws :
+    let oneBE : ByteArray := ⟨(Obend.Digest.HashBytes.be 32 1).toArray⟩
+    let y7BE : ByteArray := ⟨(Obend.Digest.HashBytes.be 32 g4FpGen7.toNat).toArray⟩
+    ofBytes32 oneBE = some (BitVec.ofNat 256 (2 ^ 248)) ∧
+    mulExec 8 (BitVec.ofNat 256 (2 ^ 248)) (BitVec.ofNat 256 (2 ^ 248)) ≠
+      BitVec.ofNat 256 (2 ^ 248) ∧
+    ofBytes32 y7BE = some (BitVec.ofNat 256 (2 ^ 120)) ∧
+    mulExec 8 (BitVec.ofNat 256 (2 ^ 120)) (BitVec.ofNat 256 (2 ^ 120)) ^^^
+      mulExec 8 g4FpGen6 (BitVec.ofNat 256 (2 ^ 120)) ^^^ 1#256 ≠ 0#256 := by
+  decide +kernel
+
+private def toBytes32UnreversedBE (a : Tower256Exec) : ByteArray :=
+  ⟨(Obend.Digest.HashBytes.be 32 a.toNat).toArray⟩
+
+#tooth ofBytes32_toBytes32 by mutation toBytes32 := toBytes32UnreversedBE
+#tooth toBytes32_eq_reverse_be by mutation toBytes32 := toBytes32UnreversedBE
+
