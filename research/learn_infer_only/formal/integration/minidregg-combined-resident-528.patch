+theorem wordCorrection_range_falsifier :
+    wordCorrection (2^191) ≠ roundDiv (2^191) (2^127) := by decide
+
+/-- Integer semantics of the source's unsigned Garner quotient computation. -/
+def wordV (T : ℤ) (s : ℕ) : ℤ :=
+  ((((T % (2^256)) / (2^(s-1))) % (2^128)) + 1) / 2
