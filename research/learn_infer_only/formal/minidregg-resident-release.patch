+/-- info: 'Minidregg.Assurance.ResidentReleaseContext.delivery_recipient' does not depend on any axioms -/
+#guard_msgs (whitespace := lax) in #print axioms Minidregg.Assurance.ResidentReleaseContext.delivery_recipient
