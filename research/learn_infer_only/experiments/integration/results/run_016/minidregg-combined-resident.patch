+/-- Same alphabets as the live full-word checker; only the relation and verifier
+are generalized from fixed c to the Context already carried by the root. -/
+noncomputable def adaptiveReduction : Reduction :=
+  { reduction baseContext with
+    R := fun _ rt w _ => (S rt.1).commit w = rt ∧ descriptorHolds evmAddDescriptor (traceOf w)
+    verify := fun _ rt w πs ρs =>
+      gateVerify (S rt.1).commit evmAddDescriptor (bitCorner 13) rt w πs ρs }
+
+private noncomputable def encFor (wv : Nat → BabyBear) :=
+  residualEmbedding evmAddDescriptor wv stage0_residuals_fit
+
+private noncomputable def localRbr (c : Context) : RbrKnowledgeSoundness (reduction c) :=
+  gateRbr (S c).commit evmAddDescriptor (bitCorner 13) encFor (fun _ _ => rfl) (by norm_num)
+
+private def localStmt (st : Stmt adaptiveReduction) : Stmt (reduction st.x.1) :=
+  ⟨st.idx, st.x, st.y⟩
+
+private noncomputable def adaptiveKState : KStateFn adaptiveReduction where
+  state := fun δ st tr w => (localRbr st.x.1).kstate.state δ (localStmt st) tr w
+  empty_iff := by
+    intro δ hδ st w
+    exact (localRbr st.x.1).kstate.empty_iff δ hδ (localStmt st) w
+  prover_monotone := by
+    intro δ hδ st rs w hlen h π
+    exact (localRbr st.x.1).kstate.prover_monotone δ hδ (localStmt st) rs w hlen h π
+  full_iff := by
+    intro δ hδ st πs ρs w
+    exact (localRbr st.x.1).kstate.full_iff δ hδ (localStmt st) πs ρs w
