+      (AirModularView.constDigit 64 7 q i : BabyBear)+asg (w.carry i.castSucc)+256 =
+    asg ((w.canonical 2).x i)+asg ((w.canonical 3).x i)+
+      (AirModularView.constDigit 64 7 q i : BabyBear)*asg w.quotient+
+      64*asg (w.carry i.succ)+4 := by
