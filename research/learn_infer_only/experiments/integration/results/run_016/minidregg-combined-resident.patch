+def middle (B a c : ℤ) : ℤ :=
+  (a%B)*(c/B)+(a/B)*(c%B)+((a%B)*(c%B))/B
+def splitQuotient (B a c : ℤ) : ℤ := middle B a c/B+(a/B)*(c/B)
