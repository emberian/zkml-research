+    exact ⟨lt_trans h.1 (by decide),lt_trans h.2.1 (by decide)⟩
+  · intro i j
+    have h := (parameter_capacities (rows i) (List.get_mem _ _)).2.2 (groupDigit profile|>.symm j).1
