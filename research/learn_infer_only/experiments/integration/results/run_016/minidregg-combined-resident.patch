+  (∀ x ∈ xs, Fresh q83 t32 freshBound x) ∧ xs.length ≤ window ∧
+  (∀ j, |query j| ≤ coordinateBound) ∧
+  (∀ x ∈ xs, ∀ j, |x.message j| ≤ coordinateBound)
