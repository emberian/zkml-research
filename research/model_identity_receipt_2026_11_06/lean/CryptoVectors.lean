      let s := Ed25519.leNat (sig.extract 32 64)
      Ed25519.eq (Ed25519.scalarMul (s + Ed25519.L) Ed25519.B) (Ed25519.scalarMul s Ed25519.B))
]

def runVec : Vec → String × Bool
  | .hash name got expected =>
    let h := toHex (got ())
    (name ++ (if h == expected then "" else s!" got {h} expected {expected}"), h == expected)
  | .ed name pk msg sig expected =>
    let r := ed25519Verify (unhex pk) (unhex msg) (unhex sig)
    (name ++ s!" (expect {expected}, got {r})", r == expected)
  | .dec name enc expected =>
    let r := (Ed25519.decodePoint (unhex enc)).isSome
    (name ++ s!" (expect decodable={expected}, got {r})", r == expected)
  | .check name ok => (name, ok ())

/-- Time `f input`. The input is perturbed by a value read after `t0` and the digest is stored
in a ref before `t1`, so the compiler cannot move the hash outside the timed region. -/
def timeIt (label : String) (input : ByteArray) (f : ByteArray → ByteArray) : IO Unit := do
  let sink ← IO.mkRef ""
  let t0 ← IO.monoNanosNow
  let x := input.set! 0 (input.get! 0 + (t0 % 1).toUInt8)
  sink.set (toHex (f x))
  let t1 ← IO.monoNanosNow
  let h ← sink.get
  IO.println s!"PERF {label}: {(t1 - t0) / 1000000} ms ({h.take 16}...)"

def main : IO UInt32 := do
  let mut fails := 0
  let mut n := 0
  for v in vectors do
    let (line, ok) := runVec v
    n := n + 1
    if ok then IO.println s!"PASS {line}" else
      IO.println s!"FAIL {line}"
      fails := fails + 1
  -- performance: input depends on a runtime value so it is not hoisted to init
  let seed := ((← IO.monoNanosNow) % 1).toUInt8
  let mib := rep (1 <<< 20) (0x61 + seed)
  timeIt "SHA-256 1 MiB" mib sha256
  timeIt "SHA-512 1 MiB" mib sha512
  timeIt "cSHAKE256 1 MiB (S=\"mir\", 64-byte out)" mib (fun x => cshake256 x 64 ByteArray.empty (str "mir"))
  let t0 ← IO.monoNanosNow
  let ok := ed25519Verify (unhex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    (rep seed.toNat 0)
    (unhex "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
  let t1 ← IO.monoNanosNow
  IO.println s!"PERF Ed25519 verify (TEST 1): {(t1 - t0) / 1000} us (ok={ok})"
  IO.println s!"{n - fails}/{n} vectors passed"
  return (if fails == 0 then 0 else 1)
