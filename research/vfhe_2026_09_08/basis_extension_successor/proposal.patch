+theorem capacity : ProfiledMatrix.Capacity profile rowLayout rows := by
+  constructor
+  · decide
+  · intro i; fin_cases i <;> decide
+  · intro i; fin_cases i <;> decide
+  · intro i; fin_cases i <;> decide
+  · rw [profileDerived]
