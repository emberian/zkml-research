+
+/-- info: 'Minidregg.Compiler.BfvQueryMul.padded_denote' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs in
+#print axioms Minidregg.Compiler.BfvQueryMul.padded_denote
