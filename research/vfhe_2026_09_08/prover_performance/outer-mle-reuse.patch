+/// All `chi_eval(b, point, p)` weights, in the same LSB-first order.
+///
+/// Append the next coordinate as the new high bit. Each old weight `w` splits
+/// into `w - w*x` and `w*x`, so expansion costs one multiplication per new pair
+/// instead of recomputing a product of `point.len()` factors for every corner.
+/// These weights depend on the supplied challenge and are computed only after
+/// that challenge is available; reusing them does not move transcript timing.
+fn chi_weights(point: &[Fp], p: u64) -> Vec<Fp> {
+    let size = 1usize
+        .checked_shl(point.len().try_into().expect("point dimension fits u32"))
+        .expect("equality table dimension fits usize");
+    let mut weights = Vec::with_capacity(size);
+    weights.push(1 % p);
+    for &x in point {
+        let x = x % p;
+        let old_len = weights.len();
+        for i in 0..old_len {
+            let high = mul_mod(weights[i], x, p);
+            weights.push(high);
+            weights[i] = sub_mod(weights[i], high, p);
+        }
+    }
+    weights
+}
