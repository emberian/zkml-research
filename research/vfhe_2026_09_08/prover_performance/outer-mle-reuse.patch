--- /dev/null
+++ b/prover/tests/matmul_binding_reuse.rs
@@ -0,0 +1,100 @@
+//! Differential controls for equality-weight reuse in the existing contraction.
+//! The literal chi basis remains the independent oracle; no second proof API.
+use minidregg_prover::sumcheck::{chi_eval, mle2_eval, MatmulClaim};
+
+fn add(a: u64, b: u64, p: u64) -> u64 {
+    ((a as u128 + b as u128) % p as u128) as u64
+}
+fn mul(a: u64, b: u64, p: u64) -> u64 {
+    ((a as u128 * b as u128) % p as u128) as u64
+}
+fn data(n: usize, seed: u64) -> Vec<u64> {
+    let mut s = seed;
+    (0..n)
+        .map(|_| {
+            s = s
+                .wrapping_mul(6364136223846793005)
+                .wrapping_add(1442695040888963407);
+            s
+        })
+        .collect()
+}
+
+#[test]
+fn partials_and_output_opening_match_literal_basis() {
+    for p in [5, 97, 2013265921] {
+        for (mu, kappa, nu) in [(0, 0, 0), (0, 2, 3), (3, 2, 0), (1, 3, 2), (3, 1, 2)] {
+            let claim = MatmulClaim {
+                mu,
+                kappa,
+                nu,
+                a: (0..1 << mu).map(|i| data(1 << kappa, 11 + i)).collect(),
+                b: (0..1 << kappa).map(|q| data(1 << nu, 97 + q)).collect(),
+            };
+            for case in 0..3 {
+                let point = |n, seed| {
+                    if case == 0 {
+                        vec![0; n]
+                    } else if case == 1 {
+                        vec![1; n]
+                    } else {
+                        data(n, seed)
+                    }
+                };
+                let x = point(mu, 41);
+                let y = point(nu, 53);
+                let expected_a: Vec<_> = (0..1 << kappa)
+                    .map(|q| {
+                        (0..1 << mu).fold(0, |s, i| {
+                            add(s, mul(claim.a[i][q] % p, chi_eval(i, &x, p), p), p)
+                        })
+                    })
+                    .collect();
+                let expected_b: Vec<_> = (0..1 << kappa)
+                    .map(|q| {
+                        (0..1 << nu).fold(0, |s, j| {
+                            add(s, mul(claim.b[q][j] % p, chi_eval(j, &y, p), p), p)
+                        })
+                    })
+                    .collect();
+                assert_eq!(claim.row_partial(&x, p), expected_a);
+                assert_eq!(claim.col_partial(&y, p), expected_b);
+                let output = claim.output(p);
+                let expected = (0..1 << mu).fold(0, |s, i| {
+                    (0..1 << nu).fold(s, |s, j| {
+                        add(
+                            s,
+                            mul(
+                                mul(output[i][j], chi_eval(i, &x, p), p),
+                                chi_eval(j, &y, p),
+                                p,
+                            ),
+                            p,
+                        )
+                    })
+                });
+                assert_eq!(mle2_eval(&output, &x, &y, p), expected);
+            }
+        }
+    }
+}
+
+#[test]
+fn asymmetric_corners_keep_lsb_and_row_column_order() {
+    let table = vec![
+        vec![2, 3, 5, 7],
+        vec![11, 13, 17, 19],
+        vec![23, 29, 31, 37],
+        vec![41, 43, 47, 53],
+    ];
+    assert_eq!(mle2_eval(&table, &[1, 0], &[0, 1], 97), 17);
+    assert_eq!(mle2_eval(&table, &[0, 1], &[1, 0], 97), 29);
+    assert_ne!(17, 29);
+}
+
+#[test]
+#[should_panic(expected = "table cols must be")]
+fn malformed_shape_is_checked_before_weight_allocation() {
+    // The old implementation rejects this shape before any large allocation.
+    mle2_eval(&[vec![1]], &[], &[0; 40], 97);
+}
