+#guard_msgs in #print axioms patch_post
+/-- info: 'Minidregg.Assurance.CiphertextWindowCell.materialized_window_binding' depends on axioms: [propext,
+ Classical.choice,
+ Quot.sound] -/
+#guard_msgs in #print axioms materialized_window_binding
