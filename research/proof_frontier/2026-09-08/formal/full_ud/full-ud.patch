+          Polynomial.Bivariate.evalY z B = (quot_x z) * (Polynomial.Bivariate.evalY z A) := by
+    intro z hz
+    have hz_good : z ∈ good := by simpa [P_y] using hz
+    let Pz : F[X] := Classical.choose
+      (rs_nearby_polynomial hd (hclose z hz_good))
+    have hPz :
