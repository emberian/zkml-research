+/-- A degree-M nonzero singular matrix; M=0 also gives an inhabited instance. -/
+noncomputable def degreeWitnessMatrix (M : ℕ) : Matrix (Fin 2) (Fin 2) F[X] :=
+  fun _ => ![X ^ M, 1]
+
+/-- The explicit annihilator attains the claimed M*1 degree bound. -/
+noncomputable def degreeWitnessVector (M : ℕ) : Fin 2 → F[X] := ![1, -(X ^ M)]
+
+theorem degree_witnessMatrix_premises (M : ℕ) :
+    DegreePremises M 1 (degreeWitnessMatrix (F := F) M) := by
+  refine ⟨by simp, ?_, ?_⟩
+  · intro i j
+    fin_cases j <;> simp [degreeWitnessMatrix]
+  · intro r
+    simp [Matrix.det_fin_two, degreeWitnessMatrix]
+
+theorem degree_witnessVector_valid (M : ℕ) :
+    degreeWitnessVector (F := F) M ≠ 0 ∧
+    (∀ t, (degreeWitnessVector (F := F) M t).natDegree ≤ M) ∧
+    Matrix.mulVec (degreeWitnessMatrix (F := F) M) (degreeWitnessVector M) = 0 := by
+  refine ⟨?_, ?_, ?_⟩
+  · intro h
+    have := congrFun h 0
+    simp [degreeWitnessVector] at this
+  · intro t
+    fin_cases t <;> simp [degreeWitnessVector]
+  · ext i
+    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two,
+      degreeWitnessMatrix, degreeWitnessVector]
+
+/-- The degree-M hypotheses are inhabited by a nonzero matrix over every field. -/
+theorem degree_premises_inhabited (M : ℕ) :
+    ∃ K : Matrix (Fin 2) (Fin 2) F[X], K ≠ 0 ∧ DegreePremises M 1 K := by
+  refine ⟨degreeWitnessMatrix M, ?_, degree_witnessMatrix_premises M⟩
+  intro h
+  have := congrFun (congrFun h 0) 1
+  simp [degreeWitnessMatrix] at this
+
+/-- An actual matrix and annihilator satisfy the generalized contract for every M. -/
+theorem degree_satisfiable (M : ℕ) :
+    ∃ K : Matrix (Fin 2) (Fin 2) F[X],
+      DegreePremises M 1 K ∧ DegreeBoundedKernel M 1 K := by
+  refine ⟨degreeWitnessMatrix M, degree_witnessMatrix_premises M,
+    degreeWitnessVector M, ?_⟩
+  simpa using degree_witnessVector_valid (F := F) M
+
+/-- Vanishing maximal minors cannot be omitted, at any entry-degree bound. -/
+theorem degree_determinant_hypothesis_teeth (M e : ℕ) :
+    e + 1 ≤ Fintype.card (Fin (e + 1)) ∧
+    (∀ i j, ((1 : Matrix (Fin (e + 1)) (Fin (e + 1)) F[X]) i j).natDegree ≤ M) ∧
+    ¬ DegreeBoundedKernel M e (1 : Matrix (Fin (e + 1)) (Fin (e + 1)) F[X]) := by
+  classical
+  refine ⟨by simp, ?_, ?_⟩
+  · intro i j
+    by_cases h : i = j <;> simp [Matrix.one_apply, h]
+  · rintro ⟨a, ha, _, hmul⟩
+    exact ha (by simpa using hmul)
+
+/-- The e=1 degree bound is tight for arbitrary M; positive M excludes
+an actually weaker nonnegative coefficient-degree bound. -/
+theorem degree_strict_bound_teeth (M : ℕ) :
+    ¬ ∃ a : Fin 2 → F[X], a ≠ 0 ∧
+      (∀ t, (a t).natDegree < M) ∧
+      Matrix.mulVec (degreeWitnessMatrix (F := F) M) a = 0 := by
+  rintro ⟨a, ha, hdeg, hmul⟩
+  have heq : X ^ M * a 0 + a 1 = 0 := by
+    simpa [Matrix.mulVec, dotProduct, Fin.sum_univ_two, degreeWitnessMatrix]
+      using congrFun hmul 0
+  have ha0 : a 0 = 0 := by
+    by_contra hne
+    have hnd : (a 0).natDegree + M = (a 1).natDegree := by
+      have h := congrArg (fun p : F[X] => p.natDegree)
+        (eq_neg_of_add_eq_zero_left heq)
+      simpa [Polynomial.natDegree_X_pow_mul M hne] using h
+    have := hdeg 1
+    omega
+  have ha1 : a 1 = 0 := by simpa [ha0] using heq
+  apply ha
+  funext t
+  fin_cases t
+  · exact ha0
+  · exact ha1
+
+/-- The entry-degree assumption is needed: degree-one entries can force a
+positive-degree annihilator, contradicting the falsely substituted M=0 conclusion. -/
+theorem entry_degree_hypothesis_teeth :
+    Premises 1 (witnessMatrix (F := F)) ∧
+      ¬ DegreeBoundedKernel 0 1 (witnessMatrix (F := F)) := by
+  refine ⟨witnessMatrix_premises, ?_⟩
+  simpa [DegreeBoundedKernel] using degree_bound_teeth (F := F)
+
 end PolynomialMatrixKernel
 
