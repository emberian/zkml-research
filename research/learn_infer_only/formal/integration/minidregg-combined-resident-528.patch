+def groupDigit : Fin 10 × Fin 19 ≃ Fin 190 := finProdFinEquiv
+
+def digitCoefficient (matrix : Fin 10 → ℕ) (i : Fin 190) : ℕ :=
+  matrix (groupDigit.symm i).1 * 64^(groupDigit.symm i).2.val
+
