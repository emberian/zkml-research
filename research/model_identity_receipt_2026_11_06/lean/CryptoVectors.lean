import Mir.Crypto
/-!
Test vectors for `Mir.Crypto`. Expected values: SHA-256/SHA-512/SHAKE256 from Python
hashlib; cSHAKE256 (with function name N) and KMAC256 from pycryptodome 3.x; NIST SP 800-185
cSHAKE256 samples #3 and #4; Ed25519 from RFC 8032 section 7.1 (cross-checked against OpenSSL
via python `cryptography`). One line per vector; exit code 1 on any failure.
-/
open Mir.Crypto

def str (s : String) : ByteArray := s.toUTF8

def rep (n : Nat) (b : UInt8) : ByteArray := Id.run do
  let mut out := ByteArray.emptyWithCapacity n
  for _ in [0:n] do out := out.push b
  return out

/-- Bytes `i mod 251` for `i < n`. -/
def pat (n : Nat) : ByteArray := Id.run do
  let mut out := ByteArray.emptyWithCapacity n
  for i in [0:n] do out := out.push (i % 251).toUInt8
  return out

/-- KMAC256 (SP 800-185 4.3), used only to exercise cSHAKE256 with N = "KMAC". -/
def kmac256 (k x s : ByteArray) (outBytes : Nat) : ByteArray :=
  let newX := Keccak.bytepad (Keccak.encodeString k) Keccak.rate256 ++ x ++
    Keccak.rightEncode (8 * outBytes)
  cshake256 newX outBytes (str "KMAC") s

def unhex (s : String) : ByteArray := (ofHex? s).getD ByteArray.empty

inductive Vec where
  | hash (name : String) (got : Unit → ByteArray) (expected : String)
  | ed (name : String) (pk msg sig : String) (expected : Bool)
  | dec (name : String) (enc : String) (expected : Bool)
  | check (name : String) (ok : Unit → Bool)

def hvec (name : String) (got : ByteArray) (expected : String) : Vec :=
  .hash name (fun _ => got) expected
def edvec := Vec.ed
def decvec := Vec.dec

