+/-
+# Integer lift and scale refinement for a specified BFV reference
+
+Statement first: canonical operand lifts, verified INTEGER negacyclic convolution,
+and INTEGER quotient/remainder certificates force the reference output. The chosen
+reference is nearest, ties toward +infinity; a generic bias permits a separate floor
+reference. This does NOT assert equivalence to SEAL's BEHZ implementation: its basis
+extension, selected lifts, fast floor, and conversion back are separate obligations.
+
+ATLAS poles are below: nonzero and negative negacyclic witnesses; every canonical
+input has a certificate; 1 versus 32 modulo 31 refutes residue-only multiplication;
+a missing remainder range, wrong lift, modular-only equation, and floor-for-nearest
+substitution each have an explicit counterexample. No cryptographic assumptions.
+
+The data model is ONE common operand vector, so Hole A's shared-opening provenance
+is a premise. No claim about an emitter or its commitment/proof soundness is made.
+-/
+import Mathlib.Tactic
+
+namespace Minidregg.Compiler.BFVScaleLift
+
+set_option autoImplicit false
+open scoped BigOperators
+
+/-- Integer coefficient of a*b in Z[X]/(X^N+1), with NO mod-Q reduction. -/
+def convolution {N : ℕ} (a b : Fin N → ℤ) (k : Fin N) : ℤ :=
+  ∑ i : Fin N, if i.val ≤ k.val then a i * b (k - i) else -(a i * b (k - i))
+
+/-- Explicit canonical representative choice. Other conventions require another theorem. -/
+def canonical (Q : ℤ) {N : ℕ} (a : Fin N → ℤ) : Prop :=
+  ∀ i, 0 ≤ a i ∧ a i < Q
+
+/-- Euclidean integer division; for positive Q and bias=Q/2 this is nearest, ties up. -/
+def scale (Q t bias z : ℤ) : ℤ := (t * z + bias) / Q
+
+def nearest (Q t z : ℤ) : ℤ := scale Q t (Q / 2) z
+
+def reference {N : ℕ} (Q t : ℤ) (a b : Fin N → ℤ) : Fin N → ℤ :=
+  fun k => nearest Q t (convolution a b k) % Q
+
+/-- A checker relation, before reduction into any proof field. -/
+def quotientCertificate (Q t bias z y r : ℤ) : Prop :=
+  0 ≤ r ∧ r < Q ∧ t * z + bias = Q * y + r
+
+/-- Witness data are arbitrary: wrong lifts and forged outputs are representable. -/
+structure Witness (N : ℕ) where
+  lifted : Fin N → ℤ
+  quotient : Fin N → ℤ
+  remainder : Fin N → ℤ
+
+/-- All conjunctions are checker obligations, not trusted witness constructors. -/
+def accepts {N : ℕ} (Q t : ℤ) (a b out : Fin N → ℤ) (w : Witness N) : Prop :=
+  0 < Q ∧ 0 < t ∧ t < Q ∧ canonical Q a ∧ canonical Q b ∧
+  (∀ k, w.lifted k = convolution a b k) ∧
+  (∀ k, quotientCertificate Q t (Q / 2) (w.lifted k) (w.quotient k) (w.remainder k)) ∧
+  (∀ k, out k = w.quotient k % Q)
+
+/-- The precise named target: accepted integer certificates FORCE the chosen reference. -/
+def BFVScaleLiftRefinement : Prop :=
+  ∀ {N : ℕ} (Q t : ℤ) (a b out : Fin N → ℤ) (w : Witness N),
+    accepts Q t a b out w → out = reference Q t a b
+
+/-- Euclidean division turns a bounded integer remainder into a unique quotient. -/
+theorem quotient_forced (Q t bias z y r : ℤ) (hQ : 0 < Q)
+    (h : quotientCertificate Q t bias z y r) : y = scale Q t bias z := by
+  rcases h with ⟨hr0, hrQ, heq⟩
+  unfold scale
+  apply le_antisymm
+  · rw [Int.le_ediv_iff_mul_le hQ]
+    nlinarith
+  · have hh : (t * z + bias) / Q < y + 1 := by
+      rw [Int.ediv_lt_iff_lt_mul hQ]
+      nlinarith
+    omega
+
+/-- Every integer, including a negative convolution coefficient, has a certificate. -/
+theorem quotient_complete (Q t bias z : ℤ) (hQ : 0 < Q) :
+    quotientCertificate Q t bias z (scale Q t bias z) ((t * z + bias) % Q) := by
+  refine ⟨Int.emod_nonneg _ (ne_of_gt hQ), Int.emod_lt_of_pos _ hQ, ?_⟩
+  exact (Int.mul_ediv_add_emod _ _).symm
+
+/-- Kernel proof of the named refinement; no field equation is substituted for integer equality. -/
+theorem bfvScaleLiftRefinement : BFVScaleLiftRefinement := by
+  intro N Q t a b out w h
+  rcases h with ⟨hQ, _, _, _, _, hlift, hcert, hout⟩
+  funext k
+  rw [hout k, quotient_forced Q t (Q / 2) _ _ _ hQ (hcert k), hlift k]
+  rfl
+
+/-- Honest witness construction performs the specified integer convolution and division. -/
+def honestWitness {N : ℕ} (Q t : ℤ) (a b : Fin N → ℤ) : Witness N where
+  lifted := convolution a b
+  quotient := fun k => nearest Q t (convolution a b k)
+  remainder := fun k => (t * convolution a b k + Q / 2) % Q
+
+/-- Universal premise inhabitation on canonical vectors, not one hand-picked equation. -/
+theorem honest_accepts {N : ℕ} (Q t : ℤ) (a b : Fin N → ℤ)
+    (hQ : 0 < Q) (ht : 0 < t) (htQ : t < Q)
+    (ha : canonical Q a) (hb : canonical Q b) :
+    accepts Q t a b (reference Q t a b) (honestWitness Q t a b) := by
+  refine ⟨hQ, ht, htQ, ha, hb, fun _ => rfl, ?_, fun _ => rfl⟩
+  intro k
+  exact quotient_complete Q t (Q / 2) _ hQ
+
+/-- A canonical representative is pinned by its bound and congruence to the source. -/
+theorem canonical_lift_unique (Q x y : ℤ) (hx : 0 ≤ x ∧ x < Q)
+    (hy : 0 ≤ y ∧ y < Q) (hmod : x % Q = y % Q) : x = y := by
+  rwa [Int.emod_eq_of_lt hx.1 hx.2, Int.emod_eq_of_lt hy.1 hy.2] at hmod
+
+/-- Exact N-term convolution range, for arbitrary signed bounded lifts. -/
+theorem convolution_bound {N : ℕ} (a b : Fin N → ℤ) (A B : ℤ)
+    (hA : 0 ≤ A) (_hB : 0 ≤ B)
+    (ha : ∀ i, |a i| ≤ A) (hb : ∀ i, |b i| ≤ B) (k : Fin N) :
+    |convolution a b k| ≤ (N : ℤ) * A * B := by
+  unfold convolution
+  calc
+    _ ≤ ∑ i : Fin N, |if i.val ≤ k.val then a i * b (k - i) else -(a i * b (k - i))| :=
+      Finset.abs_sum_le_sum_abs _ _
+    _ ≤ ∑ _i : Fin N, A * B := by
+      apply Finset.sum_le_sum
+      intro i _
+      have hm : |a i * b (k - i)| ≤ A * B := by
+        rw [abs_mul]
+        exact mul_le_mul (ha i) (hb (k - i)) (abs_nonneg _) hA
+      split_ifs <;> simpa only [abs_neg] using hm
+    _ = (N : ℤ) * A * B := by simp; ring
+
+/-- The offset convention really is floor((2tz+Q)/(2Q)), including negative z. -/
+theorem nearest_eq_doubled (Q t z : ℤ) (hQ : 0 < Q) :
+    nearest Q t z = (2 * t * z + Q) / (2 * Q) := by
+  let y := nearest Q t z
+  let r := (t * z + Q / 2) % Q
+  have hc := quotient_complete Q t (Q / 2) z hQ
+  have hqr : 0 ≤ Q % 2 ∧ Q % 2 < 2 := ⟨Int.emod_nonneg _ (by decide), Int.emod_lt_of_pos _ (by decide)⟩
+  have heq := Int.mul_ediv_add_emod Q 2
+  have h2Q : 0 < 2 * Q := by omega
+  have hcert : quotientCertificate (2 * Q) (2 * t) Q z y (2 * r + Q % 2) := by
+    rcases hc with ⟨hr0, hrQ, he⟩
+    dsimp [y, r]
+    constructor
+    · omega
+    constructor
+    · omega
+    · dsimp [nearest, scale] at he ⊢
+      nlinarith
+  have hp := quotient_forced (2 * Q) (2 * t) Q z y (2 * r + Q % 2) h2Q hcert
+  simpa [y, scale, mul_assoc] using hp
+
+/-- The correct scale changes by t under a Q-shift; no residue-only factorization. -/
+theorem nearest_shift (Q t z : ℤ) (hQ : 0 < Q) :
+    nearest Q t (z + Q) = nearest Q t z + t := by
+  unfold nearest scale
+  have heq : t * (z + Q) + Q / 2 = (t * z + Q / 2) + t * Q := by ring
+  rw [heq, Int.add_mul_ediv_right _ _ (ne_of_gt hQ)]
+
+/-- A canonical residue cannot substitute for the full integer product. -/
+theorem residue_only_falsifier :
+    (1 : ℤ) * 1 % 31 = 2 * 16 % 31 ∧
+    nearest 31 4 (1 * 1) % 31 = 0 ∧
+    nearest 31 4 (2 * 16) % 31 = 4 := by decide
+
+/-- No function of the raw product residue can return both correct scaled results. -/
+theorem no_residue_factor :
+    ¬ ∃ f : ℤ → ℤ, ∀ z : ℤ, f (z % 31) = nearest 31 4 z % 31 := by
+  rintro ⟨f, hf⟩
+  have h1 := hf 1
+  have h32 := hf 32
+  norm_num [nearest, scale] at h1 h32
+  omega
+
+/-- Mod-Q certificate checking deletes the quotient, even when r is in range. -/
+theorem modular_equation_falsifier :
+    (0 : ℤ) ≤ 19 ∧ 19 < 31 ∧
+    (4 * 1 + 31 / 2) % 31 = (31 * 17 + 19) % 31 ∧ nearest 31 4 1 ≠ 17 := by decide
+
+/-- The remainder range is necessary; equality alone accepts an arbitrary quotient. -/
+theorem remainder_range_falsifier :
+    (4 : ℤ) * 1 + 31 / 2 = 31 * 1 + (-12) ∧ nearest 31 4 1 ≠ 1 := by decide
+
+/-- A wrong integer lift produces its own valid certificate. Binding to convolution is essential. -/
+theorem lift_binding_falsifier :
+    quotientCertificate 31 4 15 1 0 19 ∧ (1 : ℤ) % 31 = 32 % 31 ∧
+    nearest 31 4 32 ≠ 0 := by
+  unfold quotientCertificate
+  decide
+
+/-- A floor certificate is NOT a nearest certificate (same input, unequal outputs). -/
+theorem rounding_rule_falsifier :
+    scale 31 4 0 4 = 0 ∧ nearest 31 4 4 = 1 ∧
+    scale 31 4 0 (-4) = -1 ∧ nearest 31 4 (-4) = -1 := by decide
+
+/-- Ties go toward +infinity, not away from zero or toward zero in general. -/
+theorem ties_up_witness : nearest 4 1 2 = 1 ∧ nearest 4 1 (-2) = 0 := by decide
+
+/-- A nonzero product and a negative wrapped coefficient inhabit the actual carrier. -/
+theorem negacyclic_witness :
+    convolution ![(1 : ℤ), 2] ![(3 : ℤ), 4] 0 = -5 ∧
+    convolution ![(1 : ℤ), 2] ![(3 : ℤ), 4] 1 = 10 ∧
+    reference 31 4 ![(1 : ℤ), 2] ![(3 : ℤ), 4] 0 = 30 ∧
+    reference 31 4 ![(1 : ℤ), 2] ![(3 : ℤ), 4] 1 = 1 := by decide
+
+/-- Nonempty satisfying acceptance set with a changing, nonzero output. -/
+theorem premise_inhabited :
+    ∃ (a b out : Fin 2 → ℤ) (w : Witness 2),
+      accepts 31 4 a b out w ∧ out 0 ≠ out 1 := by
+  refine ⟨![1, 2], ![3, 4], reference 31 4 ![1, 2] ![3, 4],
+    honestWitness 31 4 ![1, 2] ![3, 4], ?_, ?_⟩
+  · apply honest_accepts <;> (try unfold canonical) <;> decide
+  · decide
+
+/-- Bad outputs are representable but refused for EVERY witness. -/
+theorem forged_output_refused :
+    ∀ w : Witness 2, ¬ accepts 31 4 ![1, 2] ![3, 4] ![0, 1] w := by
+  intro w h
+  have hf := congrFun (bfvScaleLiftRefinement 31 4 ![1, 2] ![3, 4] ![0, 1] w h) 0
+  have hr := negacyclic_witness.2.2.1
+  change (0 : ℤ) = reference 31 4 ![1, 2] ![3, 4] 0 at hf
+  omega
+
+
+
+/-- The unbounded integer quotient can be represented in a finite signed range once
+these two numeric inequalities are checked. No quotient-range assumption is trusted. -/
+theorem quotient_range (Q t bias z y r Z Y : ℤ) (hQ : 0 < Q) (ht : 0 ≤ t)
+    (hz : |z| ≤ Z) (hcert : quotientCertificate Q t bias z y r)
+    (hlo : -(Q * Y) ≤ -t * Z + bias)
+    (hhi : t * Z + bias < Q * (Y + 1)) : |y| ≤ Y := by
+  rw [quotient_forced Q t bias z y r hQ hcert]
+  apply abs_le.mpr
+  rcases abs_le.mp hz with ⟨hzlo, hzhi⟩
+  constructor
+  · unfold scale
+    rw [Int.le_ediv_iff_mul_le hQ]
+    nlinarith
+  · unfold scale
+    have hy : (t * z + bias) / Q < Y + 1 := by
+      rw [Int.ediv_lt_iff_lt_mul hQ]
+      nlinarith
+    omega
+
+/-- A finite-field equation lifts only with a proved no-wrap bound on its residual. -/
+theorem residual_lift (p e : ℤ) (hp : 0 < p) (hm : e % p = 0)
+    (hr : |e| < p) : e = 0 := by
+  apply Int.eq_zero_of_dvd_of_natAbs_lt_natAbs (Int.dvd_of_emod_eq_zero hm)
+  have hpa : |p| = p := abs_of_pos hp
+  have hh : |e| < |p| := by omega
+  have hcast : (e.natAbs : ℤ) < (p.natAbs : ℤ) := by
+    simpa only [Int.natCast_natAbs] using hh
+  exact_mod_cast hcast
+
+/-- Merely bounding y and r below Q does not lift a smaller proof-field equation. -/
+theorem proof_field_wrap_falsifier :
+    (0 : ℤ) ≤ 7 ∧ 7 < 31 ∧ 0 ≤ 19 ∧ 19 < 31 ∧
+    (4 * 1 + 15 - (31 * 7 + 19)) % 7 = 0 ∧ nearest 31 4 1 ≠ 7 := by decide
+
+/-- The algebra implemented by fast_floor has the base-conversion alpha correction.
+This is a conditional arithmetic identity, NOT a proof of SEAL's BaseConverter. -/
+theorem fast_floor_correction (Q x y r α : ℤ) (hQ : 0 < Q)
+    (he : x = Q * y + r) : (x - (r + Q * α)) / Q = y - α := by
+  apply Int.ediv_eq_of_eq_mul_right (ne_of_gt hQ)
+  nlinarith
+
+/-- With q=(3,5), fast conversion of residue 1 is 5*2 + 3*2 = 16 = 1+Q.
+Consequently fast_floor's quotient is -1, while ordinary floor(1/15) is 0.
+Toy base-conversion witness; no claim these are valid SEAL parameters. -/
+theorem fast_floor_is_not_plain_floor :
+    ((1 : ℤ) - (5 * 2 + 3 * 2)) / 15 = -1 ∧ (1 : ℤ) / 15 = 0 := by decide
+
+
+/-- The unrelinearized size-2 by size-2 BFV tensor. The middle cross terms are added
+as INTEGERS before scaling; rounding them separately is another wrong relation. -/
+def tensor {N : ℕ} (a₀ a₁ b₀ b₁ : Fin N → ℤ) : Fin 3 → Fin N → ℤ :=
+  ![convolution a₀ b₀, fun k => convolution a₀ b₁ k + convolution a₁ b₀ k,
+    convolution a₁ b₁]
+
+def tensorReference {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ) :
+    Fin 3 → Fin N → ℤ := fun c k => nearest Q t (tensor a₀ a₁ b₀ b₁ c k) % Q
+
+def tensorAccepts {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ)
+    (out : Fin 3 → Fin N → ℤ) (w : Fin 3 → Witness N) : Prop :=
+  0 < Q ∧ 0 < t ∧ t < Q ∧
+  canonical Q a₀ ∧ canonical Q a₁ ∧ canonical Q b₀ ∧ canonical Q b₁ ∧
+  (∀ c k, (w c).lifted k = tensor a₀ a₁ b₀ b₁ c k) ∧
+  (∀ c k, quotientCertificate Q t (Q / 2) ((w c).lifted k)
+    ((w c).quotient k) ((w c).remainder k)) ∧
+  (∀ c k, out c k = (w c).quotient k % Q)
+
+def BFVTensorScaleLiftRefinement : Prop :=
+  ∀ {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ)
+    (out : Fin 3 → Fin N → ℤ) (w : Fin 3 → Witness N),
+    tensorAccepts Q t a₀ a₁ b₀ b₁ out w → out = tensorReference Q t a₀ a₁ b₀ b₁
+
+/-- The complete 3-component raw tensor has the same integer-certificate refinement. -/
+theorem tensorScaleLiftRefinement : BFVTensorScaleLiftRefinement := by
+  intro N Q t a₀ a₁ b₀ b₁ out w h
+  rcases h with ⟨hQ, _, _, _, _, _, _, hlift, hcert, hout⟩
+  funext c k
+  rw [hout c k, quotient_forced Q t (Q / 2) _ _ _ hQ (hcert c k), hlift c k]
+  rfl
+
+def honestTensorWitness {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ) :
+    Fin 3 → Witness N := fun c =>
+  { lifted := tensor a₀ a₁ b₀ b₁ c
+    quotient := fun k => nearest Q t (tensor a₀ a₁ b₀ b₁ c k)
+    remainder := fun k => (t * tensor a₀ a₁ b₀ b₁ c k + Q / 2) % Q }
+
+/-- Every canonical size-2 ciphertext pair has an accepted full-tensor certificate. -/
+theorem honest_tensor_accepts {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ)
+    (hQ : 0 < Q) (ht : 0 < t) (htQ : t < Q)
+    (ha₀ : canonical Q a₀) (ha₁ : canonical Q a₁)
+    (hb₀ : canonical Q b₀) (hb₁ : canonical Q b₁) :
+    tensorAccepts Q t a₀ a₁ b₀ b₁ (tensorReference Q t a₀ a₁ b₀ b₁)
+      (honestTensorWitness Q t a₀ a₁ b₀ b₁) := by
+  refine ⟨hQ, ht, htQ, ha₀, ha₁, hb₀, hb₁, fun _ _ => rfl, ?_, fun _ _ => rfl⟩
+  intro c k
+  exact quotient_complete Q t (Q / 2) _ hQ
+
+/-- Non-vacuity on the full tensor, with all four input polynomials nonzero. -/
+theorem tensor_premise_inhabited :
+    tensorAccepts 31 4 ![2] ![2] ![2] ![2]
+      (tensorReference 31 4 ![2] ![2] ![2] ![2])
+      (honestTensorWitness 31 4 ![2] ![2] ![2] ![2]) := by
+  apply honest_tensor_accepts <;> (try unfold canonical) <;> decide
+
+/-- Round-after-sum cannot be replaced by sum-after-round at the middle component. -/
+theorem tensor_cross_terms_falsifier :
+    tensorReference 31 4 ![2] ![2] ![2] ![2] 1 0 = 1 ∧
+    nearest 31 4 (2 * 2) + nearest 31 4 (2 * 2) = 2 := by decide
+
+end Minidregg.Compiler.BFVScaleLift
