+def biasedOfTwos (b : UInt8) : UInt8 := UInt8.ofNat (b.toNat+128)
+def signedOfTwos (b : UInt8) : Int :=
+  if b.toNat<128 then (b.toNat : Int) else (b.toNat : Int)-256
