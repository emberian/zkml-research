+open Minidregg.Compiler.CommittedTerminalRealizer.Stage0Exhibit (wordOf stage0_residuals_fit)
+open Minidregg.Compiler.CommittedTerminalController (Receipt)
+open Minidregg.Compiler.DescriptorEval
