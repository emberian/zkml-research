+  obtain ⟨rc, hrc⟩ := honest_context_receipt 1 2 (by norm_num) (by norm_num) O
+  exact ⟨rc, honest_accepted, hrc, by decide⟩
+
+end Closed
+end Minidregg.Assurance.ResidentRestoreFinality
