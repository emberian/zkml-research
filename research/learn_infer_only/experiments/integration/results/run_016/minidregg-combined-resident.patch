+
+/-- The unrelinearized size-2 by size-2 BFV tensor. The middle cross terms are added
+as INTEGERS before scaling; rounding them separately is another wrong relation. -/
+def tensor {N : ℕ} (a₀ a₁ b₀ b₁ : Fin N → ℤ) : Fin 3 → Fin N → ℤ :=
+  ![convolution a₀ b₀, fun k => convolution a₀ b₁ k + convolution a₁ b₀ k,
+    convolution a₁ b₁]
+
+def tensorReference {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ) :
+    Fin 3 → Fin N → ℤ := fun c k => nearest Q t (tensor a₀ a₁ b₀ b₁ c k) % Q
+
+def tensorAccepts {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ)
+    (out : Fin 3 → Fin N → ℤ) (w : Fin 3 → Witness N) : Prop :=
+  0 < Q ∧ 0 < t ∧ t < Q ∧
+  canonical Q a₀ ∧ canonical Q a₁ ∧ canonical Q b₀ ∧ canonical Q b₁ ∧
+  (∀ c k, (w c).lifted k = tensor a₀ a₁ b₀ b₁ c k) ∧
+  (∀ c k, quotientCertificate Q t (Q / 2) ((w c).lifted k)
+    ((w c).quotient k) ((w c).remainder k)) ∧
+  (∀ c k, out c k = (w c).quotient k % Q)
+
+def BFVTensorScaleLiftRefinement : Prop :=
+  ∀ {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ)
+    (out : Fin 3 → Fin N → ℤ) (w : Fin 3 → Witness N),
+    tensorAccepts Q t a₀ a₁ b₀ b₁ out w → out = tensorReference Q t a₀ a₁ b₀ b₁
+
+/-- The complete 3-component raw tensor has the same integer-certificate refinement. -/
+theorem tensorScaleLiftRefinement : BFVTensorScaleLiftRefinement := by
+  intro N Q t a₀ a₁ b₀ b₁ out w h
+  rcases h with ⟨hQ, _, _, _, _, _, _, hlift, hcert, hout⟩
+  funext c k
+  rw [hout c k, quotient_forced Q t (Q / 2) _ _ _ hQ (hcert c k), hlift c k]
+  rfl
+
+def honestTensorWitness {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ) :
+    Fin 3 → Witness N := fun c =>
+  { lifted := tensor a₀ a₁ b₀ b₁ c
+    quotient := fun k => nearest Q t (tensor a₀ a₁ b₀ b₁ c k)
+    remainder := fun k => (t * tensor a₀ a₁ b₀ b₁ c k + Q / 2) % Q }
+
+/-- Every canonical size-2 ciphertext pair has an accepted full-tensor certificate. -/
+theorem honest_tensor_accepts {N : ℕ} (Q t : ℤ) (a₀ a₁ b₀ b₁ : Fin N → ℤ)
+    (hQ : 0 < Q) (ht : 0 < t) (htQ : t < Q)
+    (ha₀ : canonical Q a₀) (ha₁ : canonical Q a₁)
+    (hb₀ : canonical Q b₀) (hb₁ : canonical Q b₁) :
+    tensorAccepts Q t a₀ a₁ b₀ b₁ (tensorReference Q t a₀ a₁ b₀ b₁)
+      (honestTensorWitness Q t a₀ a₁ b₀ b₁) := by
+  refine ⟨hQ, ht, htQ, ha₀, ha₁, hb₀, hb₁, fun _ _ => rfl, ?_, fun _ _ => rfl⟩
+  intro c k
+  exact quotient_complete Q t (Q / 2) _ hQ
+
+/-- Non-vacuity on the full tensor, with all four input polynomials nonzero. -/
+theorem tensor_premise_inhabited :
+    tensorAccepts 31 4 ![2] ![2] ![2] ![2]
+      (tensorReference 31 4 ![2] ![2] ![2] ![2])
+      (honestTensorWitness 31 4 ![2] ![2] ![2] ![2]) := by
