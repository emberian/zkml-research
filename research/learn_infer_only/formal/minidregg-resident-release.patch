+/-- info: 'Minidregg.Assurance.ResidentReleaseContext.honest_changes_state' depends on axioms: [propext] -/
+#guard_msgs (whitespace := lax) in #print axioms Minidregg.Assurance.ResidentReleaseContext.honest_changes_state
