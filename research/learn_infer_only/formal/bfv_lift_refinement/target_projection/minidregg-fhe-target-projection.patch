+
+/-- info: 'Minidregg.Compiler.FheTargetProjection.source_column_budgets' depends on axioms: [propext,
+ Classical.choice,
+ Quot.sound] -/
+#guard_msgs in
+#print axioms Minidregg.Compiler.FheTargetProjection.source_column_budgets
+
