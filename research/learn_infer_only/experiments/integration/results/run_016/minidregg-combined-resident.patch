+theorem window32_ciphertext_nonzero : accumulator twenties twenties 7 inputs32 ≠ 0 := by
+  intro hz
+  have h := window32_nonzero_subject
+  simp only [outputLift, hz, map_zero, ZMod.val_zero, Nat.cast_zero] at h
