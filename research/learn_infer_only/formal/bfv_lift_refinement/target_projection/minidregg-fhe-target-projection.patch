+#guard_msgs in
+#print axioms Minidregg.Compiler.FheTargetProjection.digit_coefficient_capacity
+
+/-- info: 'Minidregg.Compiler.FheTargetProjection.digit_linearization' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs in
