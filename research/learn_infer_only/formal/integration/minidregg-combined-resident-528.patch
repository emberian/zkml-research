+    dsimp only
+    rw [hp]
+    decide +kernel
+  · have hp := honest_candidate_pins 1
+    change (candidate 24 7 14).getD 1 0 = 7 at hp
+    dsimp only
+    rw [hp]
+    decide +kernel
+
