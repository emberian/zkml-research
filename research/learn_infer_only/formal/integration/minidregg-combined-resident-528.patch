+/-- The exact reference is the first tranche's nearest-ties-up function. -/
+theorem roundDiv_eq_nearest (x d : ℤ) (hd : 0 < d) :
+    roundDiv x d = BFVScaleLift.nearest d 1 x := by
+  rw [BFVScaleLift.nearest_eq_doubled d 1 x hd]
+  simp [roundDiv]
