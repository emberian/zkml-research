+/-- A polynomial kernel with coefficient degree at most M times the rank bound. -/
+def DegreeBoundedKernel (M e : ℕ) (K : Matrix ι (Fin (e + 1)) F[X]) : Prop :=
+  ∃ a : Fin (e + 1) → F[X],
+    a ≠ 0 ∧ (∀ t, (a t).natDegree ≤ M * e) ∧ Matrix.mulVec K a = 0
+
+/-- Entry degree and rank-shape assumptions, without a kernel conclusion. -/
+def DegreePremises (M e : ℕ) (K : Matrix ι (Fin (e + 1)) F[X]) : Prop :=
+  e + 1 ≤ Fintype.card ι ∧
+  (∀ i j, (K i j).natDegree ≤ M) ∧
+  ∀ r : Fin (e + 1) → ι, Matrix.det (K.submatrix r id) = 0
+
+/-- Statement-first degree-M generalization, including M=0 and e=0. -/
+def DegreeCorrectness : Prop :=
+  ∀ (M e : ℕ) (K : Matrix ι (Fin (e + 1)) F[X]),
+    DegreePremises M e K → DegreeBoundedKernel M e K
 
